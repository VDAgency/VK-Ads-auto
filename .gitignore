# Secrets — NEVER commit (public repo)
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
*.p12
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version-local
*.egg-info/
dist/
build/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node (Block 2 web)
node_modules/
.next/

# DB dumps / data
*.sql.gz
*.dump
pgdata/
n8n_data/

# Logs / temp
*.log
*.tmp

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Internal docs — keep out of public repo (business/client info, plans)
docs/

# Claude Code local state (worktrees, session artifacts) — ignore everything
# except vendored skills and shared project settings, which travel with the
# repo so any collaborator gets the same design tooling automatically without
# personal Claude Code setup. settings.local.json (personal) stays ignored.
.claude/*
!.claude/skills/
!.claude/settings.json
