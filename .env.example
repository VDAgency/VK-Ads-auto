# Пример переменных окружения. РЕАЛЬНЫЕ значения — только в серверном .env,
# в git НЕ коммитятся (репозиторий публичный). Скопировать в .env и заполнить.

# --- Приложение ---
APP_ENV=local                 # local | staging | production

# --- База данных / кеш ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/vk_ads_auto
REDIS_URL=redis://HOST:6379/0

# Используются сервисом postgres в docker-compose:
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=vk_ads_auto

# --- Telegram-бот ---
BOT_TOKEN=                    # токен @BotFather
OPERATOR_TELEGRAM_IDS=        # Telegram ID операторов через запятую (доступ только им)

# --- VK Ads API (VK Реклама) — OAuth2-токен ---
VK_ADS_ACCESS_TOKEN=          # Bearer access_token (посев первого кабинета; дальше — таблица ad_account)
VK_ADS_REFRESH_TOKEN=         # refresh_token (обновление access_token)
VK_ADS_TOKEN_TYPE=Bearer
# Ключ шифрования токенов рекламных кабинетов в БД. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Пусто = операции с кабинетами недоступны (приложение при этом поднимается).
VK_ADS_SECRET_KEY=
# Сколько минут доверяем прошлому health-check кабинета (VK держит 3 rps).
AD_ACCOUNT_HEALTH_TTL_MINUTES=15
VK_AGENCY_CONFIRMED=false     # true — только после подтверждения агентского статуса ИП; разрешает боевое СОЗДАНИЕ КАБИНЕТОВ
VK_LIVE_CAMPAIGNS=false       # true — боевое создание КАМПАНИИ через VK Ads API (иначе заглушка, мутаций нет)
VK_CAMPAIGN_AUTOSTART=false   # true — запускать созданную кампанию сразу; false — только создать (статус prepared), оператор проверяет глазами
INTEGRATION_FORCED_CHANNEL=   # ручной выбор канала: vk_api | kotbot; пусто = по умолчанию с health-check и фолбэком

# --- Креативы (загруженные оператором медиа) ---
CREATIVES_DIR=/data/creatives # persistent-каталог хранения креативов на сервере

# --- Google (Forms / Sheets, сервис-аккаунт) ---
GOOGLE_SERVICE_ACCOUNT_JSON=  # путь к JSON сервис-аккаунта
GOOGLE_SHEET_ID=

# --- Senler ---
SENLER_API_KEY=

# --- n8n (см. docs/N8N.md) ---
N8N_API_URL=
N8N_API_KEY=
N8N_ENCRYPTION_KEY=

# --- Userbot (Telethon-сервис доставки в Telegram, spec 2026-07-13) ---
USERBOT_BASE_URL=http://userbot:8001   # внутри compose-сети (клиент ядра)
USERBOT_SECRET_KEY=                    # Fernet-ключ (base64, 32 байта) для шифрования сессий операторов
USERBOT_API_ID=                        # api_id приложения с my.telegram.org
USERBOT_API_HASH=                      # api_hash приложения с my.telegram.org
USERBOT_SESSIONS_DIR=/secrets          # каталог сессий операторов: {sender_id}.session.enc (persistent volume)
# Точки подключения к дата-центрам Telegram (spec 2026-07-31). Нужны там, где провайдер
# закрывает стандартные порты: на нашем сервере у DC2/DC4 закрыты 443 и 80, открыт 5222.
USERBOT_DC_ENDPOINTS=                  # пины "dc:ip:port[:transport]", прод: 2:149.154.167.51:5222,4:149.154.167.91:5222
USERBOT_DC_PORTS=443,5222,80           # порядок перебора портов для дата-центров без пина
USERBOT_TRANSPORT=full                 # основной транспорт: full|abridged|intermediate|obfuscated
USERBOT_TRANSPORT_FALLBACKS=obfuscated # что пробовать после основного
USERBOT_AUTH_DC_ORDER=1,5,3,2,4        # порядок дата-центров при новом логине
USERBOT_PROXY=                         # socks5://user:pass@host:port или mtproxy://host:port?secret=hex; пусто = напрямую
USERBOT_CONNECT_TIMEOUT=8              # таймаут одной попытки подключения, сек
USERBOT_CONNECT_BUDGET=45              # потолок всей цепочки перебора, сек
USERBOT_DEVICE_MODEL=VK Ads Auto       # как сессия видна в списке устройств Telegram
USERBOT_SYSTEM_VERSION=Ubuntu 24.04
USERBOT_APP_VERSION=1.0
USERBOT_LANG_CODE=ru

# --- Kotbot (браузерная автоматизация kotbot.ru, spec 2026-07-17) ---
KOTBOT_BASE_URL=                       # в проде http://kotbot:8002 (внутри compose-сети); пусто = мок-режим
KOTBOT_SECRET_KEY=                     # Fernet-ключ (base64, 32 байта), генерится на сервере; шифрует креды/сессии kotbot

# --- SMTP (Beget): info@ — информационные (ссылка на бриф), support@ — технические (кабинет) ---
SMTP_HOST=smtp.beget.com                # общий SMTP-сервер (Beget)
SMTP_PORT=465                           # SSL (альтернатива 2525, если 25/465 заблокирован)
SMTP_INFO_USER=info@vk-ads-auto.ru      # отправитель информационных писем
SMTP_INFO_PASSWORD=                      # пароль ящика info@
SMTP_INFO_FROM_NAME=VK Ads Auto
SMTP_SUPPORT_USER=support@vk-ads-auto.ru # отправитель технических писем (кабинет)
SMTP_SUPPORT_PASSWORD=                    # пароль ящика support@
SMTP_SUPPORT_FROM_NAME=VK Ads Auto
