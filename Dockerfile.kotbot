# Образ сервиса kotbot (Playwright + FastAPI). Отдельный контейнер (spec §3, §11).
# Порт наружу не публикуется — доступен только внутри compose-сети.
# Браузер Chromium ставится ТОЛЬКО в этом образе (остальным сервисам не нужен).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Сначала зависимости (кешируемый слой), затем браузер, затем код.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Chromium + системные библиотеки для headless-запуска (--with-deps → apt).
# `--no-sync`: playwright уже в окружении из предыдущего sync; без флага `uv run`
# пытается досинхронизировать проект (нужен README.md, которого ещё нет на этом слое).
# Каталог браузера — вне домашней папки root (аудит 2026-09-01, CKV_DOCKER_3):
# путь по умолчанию имеет права 0700 и недоступен непривилегированному
# пользователю app, под которым контейнер работает в рантайме. Открываем на
# чтение всем, чтобы app мог запускать браузер, поставленный от root на сборке.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN uv run --no-sync playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

COPY . .
RUN uv sync --frozen --no-dev

# Непривилегированный пользователь (аудит 2026-09-01, CKV_DOCKER_3). UID фиксирован:
# владельца на томах выставляет другой контейнер (init-permissions в compose), и
# совпасть они обязаны по номеру, а не по имени.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /secrets /data/creatives /home/app/.cache/uv \
    && chown -R app:app /app /secrets /home/app

ENV UV_CACHE_DIR=/home/app/.cache/uv

USER app

EXPOSE 8002

# --no-sync: под непривилегированным пользователем `uv run` не может писать в
# окружение проекта; без флага он попытается пересинхронизировать его при старте.
CMD ["uv", "run", "--no-sync", "uvicorn", "kotbot.main:app", "--host", "0.0.0.0", "--port", "8002"]
